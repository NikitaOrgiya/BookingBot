# Публичные переменные (доступны в браузере, не должны содержать секреты)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Современный низкопривилегированный ключ Supabase (формат sb_publishable_...).
# Заменяет устаревший NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Серверные переменные (никогда не должны попадать в клиентский код)
# Современный секретный ключ Supabase (формат sb_secret_...). Обходит RLS,
# используется только серверным привилегированным клиентом. Заменяет
# устаревший SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 1-256 символов, только A-Z a-z 0-9 "_" "-" (ограничение Telegram Bot API
# для secret_token). Сверяется с заголовком X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Bearer-токен для GET /api/cron/reminders (Этап 5, автоматические
# Telegram-напоминания). Сверяется с заголовком Authorization: Bearer
# <CRON_SECRET> константным по времени сравнением. Если переменная не
# задана — эндпоинт отвечает 401 любому запросу (fail closed), а не
# пропускает его.
CRON_SECRET=
