# Публичные переменные (доступны в браузере, не должны содержать секреты)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Современный низкопривилегированный ключ Supabase (формат sb_publishable_...).
# Заменяет устаревший NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Серверные переменные (никогда не должны попадать в клиентский код)
# Современный секретный ключ Supabase (формат sb_secret_...). Обходит RLS,
# используется только серверным привилегированным клиентом. Заменяет
# устаревший SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

CRON_SECRET=
BUSINESS_TIMEZONE=Europe/Moscow
